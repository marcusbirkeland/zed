// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // VS Code-style sidebar and terminal shortcuts.
      "ctrl-e": "workspace::ToggleLeftDock",
      "cmd-shift-i": "agent::Toggle",
      "cmd-shift-e": "project_panel::Toggle",
      "cmd-j": "workspace::ActivatePaneDown",
      "cmd-k": "workspace::ActivatePaneUp",
      "cmd-l": "workspace::ActivatePaneRight",
      "ctrl-cmd-h": "workspace::ActivatePaneLeft",
      "ctrl-:": "terminal_panel::Toggle",
      "cmd-:": "workspace::NewTerminal",
      "ctrl-shift-k": "terminal_panel::Toggle",
      "cmd-shift-k": "terminal_panel::Toggle",
      "ctrl-shift-h": "git_panel::Toggle",
      "cmd-shift-h": "git_panel::Toggle",
      "ctrl-shift-g": "git_panel::Toggle",
      "cmd-shift-g": [
        "task::Spawn",
        { "task_name": "lazygit", "reveal_target": "dock" },
      ],
      "ctrl-shift-m": "workspace::ToggleZoom",
      "cmd-shift-m": "workspace::ToggleZoom",
      "cmd-shift-o": ["task::Spawn", { "task_name": "OpenCode", "reveal_target": "dock" }],
      "cmd-shift-ø": "workspace::NewTerminal",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      // Keep these available when an editor has focus, overriding VS Code-base bindings.
      "ctrl-e": "workspace::ToggleLeftDock",
      "cmd-shift-e": "project_panel::Toggle",
      "cmd-j": "workspace::ActivatePaneDown",
      "cmd-k": "workspace::ActivatePaneUp",
      "cmd-l": "workspace::ActivatePaneRight",
      "ctrl-cmd-h": "workspace::ActivatePaneLeft",
      "ctrl-:": "terminal_panel::Toggle",
      "cmd-:": "workspace::NewTerminal",
      "ctrl-shift-k": "terminal_panel::Toggle",
      "cmd-shift-k": "terminal_panel::Toggle",
      "ctrl-shift-h": "git_panel::Toggle",
      "cmd-shift-h": "git_panel::Toggle",
      "ctrl-shift-g": "git_panel::Toggle",
      "cmd-shift-g": [
        "task::Spawn",
        { "task_name": "lazygit", "reveal_target": "dock" },
      ],
      "cmd-shift-o": ["task::Spawn", { "task_name": "OpenCode", "reveal_target": "dock" }],
      "cmd-shift-ø": "workspace::NewTerminal",
      "ctrl-alt-left": "editor::MoveToBeginningOfLine",
      "ctrl-alt-right": "editor::MoveToEndOfLine",
      "ctrl-shift-i": "agent::Toggle",
      "cmd-shift-i": "agent::Toggle",
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "cmd-shift-o": ["task::Spawn", { "task_name": "OpenCode", "reveal_target": "dock" }],
      "cmd-shift-ø": "workspace::NewTerminal",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-alt-l": "pane::ActivateNextItem",
      "cmd-alt-l": "pane::ActivateNextItem",
      "ctrl-alt-h": "pane::ActivatePreviousItem",
      "cmd-alt-h": "pane::ActivatePreviousItem",
      "ctrl-alt-d": ["pane::CloseActiveItem", { "close_pinned": false }],
      "cmd-alt-d": ["pane::CloseActiveItem", { "close_pinned": false }],
      "ctrl-shift-1": ["pane::CloseOtherItems", { "close_pinned": false }],
      "cmd-shift-1": ["pane::CloseOtherItems", { "close_pinned": false }],
      "cmd-shift-o": ["task::Spawn", { "task_name": "OpenCode", "reveal_target": "dock" }],
      "cmd-shift-ø": "workspace::NewTerminal",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-0": ["pane::CloseActiveItem", { "close_pinned": false }],
      "cmd-shift-o": ["task::Spawn", { "task_name": "OpenCode", "reveal_target": "dock" }],
      "cmd-shift-ø": "workspace::NewTerminal",
      "cmd-j": "workspace::ActivatePaneDown",
      "cmd-k": "workspace::ActivatePaneUp",
      "cmd-l": "workspace::ActivatePaneRight",
      "ctrl-cmd-h": "workspace::ActivatePaneLeft",
      "cmd-alt-k": "terminal::Clear",
      "ctrl-shift-n": "workspace::NewTerminal",
      "cmd-shift-n": "workspace::NewTerminal",
      "ctrl-shift-m": "workspace::ToggleZoom",
      "cmd-shift-m": "workspace::ToggleZoom",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "n": "project_panel::NewFile",
      "r": "project_panel::Rename",
      "shift-n": "project_panel::NewDirectory",
      "d": ["project_panel::Trash", { "skip_prompt": false }],
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-o": ["task::Spawn", { "task_name": "OpenCode", "reveal_target": "dock" }],
      "cmd-shift-ø": "workspace::NewTerminal",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-shift-o": ["task::Spawn", { "task_name": "OpenCode", "reveal_target": "dock" }],
      "cmd-shift-ø": "workspace::NewTerminal",
    },
  },
]
