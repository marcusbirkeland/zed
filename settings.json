// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git_panel": {
    "tree_view": true,
    "dock": "left",
    "button": false
  },
  "title_bar": {
    "show_menus": false,
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_user_menu": false
  },
  "terminal": {
    "font_family": "MesloLGS NF",
    "show_count_badge": false,
    "button": false
  },
  "diagnostics": {
    "button": false
  },
  "search": {
    "button": false
  },
  "debugger": {
    "button": false
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow"
        }
      }
    },
    "sandbox_permissions": {
      "write_paths": [
        {
          "requested": "/Users/mc/.config/zed",
          "resolved": "/Users/mc/.config/zed"
        }
      ],
      "network_hosts": [
        "zed.dev",
        "raw.githubusercontent.com",
        "api.github.com"
      ]
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-6-luna",
      "enable_thinking": true,
      "effort": "medium"
    },
    "threads_sidebar": {
      "position": "right"
    },
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "claude-opus-5.5",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-6-luna",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "model_parameters": []
  },
  "icon_theme": "Material Icon Theme",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "project_panel": {
    "git_status_indicator": false,
    "default_width": 239.0,
    "dock": "left",
    "git_status": false
  },
  "outline_panel": {
    "git_status": false
  },
  "tabs": {
    "git_status": false
  },
  "sticky_scroll": {
    "enabled": true
  },
  "scroll_sensitivity": 2.0,
  "minimap": {
    "show": "never"
  },
  "selection_highlight": false,
  "auto_indent_on_paste": false,
  "semantic_tokens": "off",
  "line_ending": "prefer_lf",
  "format_on_save": "on",
  "indent_guides": {
    "enabled": false
  },
  "tab_size": 2,
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
}
